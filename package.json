{
  "name": "gh-actions-luarocks",
  "version": "1.0.1",
  "description": "Build and install Lua",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.js --bundle --analyze=verbose --target=es2020,node20 --platform=node --minify --outdir=dist/",
    "test": "npm run build && node dist/main.js",
    "check": "eslint --no-config-lookup --debug main.js",
    "format": "eslint --fix --no-config-lookup --debug main.js"
  },
  "packageManager": "npm@10.8.3+sha512.d08425c8062f56d43bb8e84315864218af2492eb769e1f1ca40740f44e85bd148969382d651660363942e5909cb7ffcbef7ca0ae963ddc2c57a51243b4da8f56",
  "author": "leaf corcoran <leafot@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.2",
    "eslint": "^9.11.0"
  }
}
